{
  "name": "gtm-migrate",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "description": "A read-only Chrome extension for reviewing Google Tag Manager workspace changes before publishing.",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "seed:gtm-baseline": "tsx scripts/gtm-seeder/cli.ts baseline",
    "seed:gtm-changes": "tsx scripts/gtm-seeder/cli.ts changes",
    "seed:gtm-cleanup": "tsx scripts/gtm-seeder/cli.ts cleanup"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.2.6",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "google-auth-library": "^11.0.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
